{
  "name": "ron-assistant-claude",
  "productName": "Ron Assistant",
  "version": "0.3.1",
  "private": true,
  "description": "Ask Claude, Codex and other configured models at once, compare or let them review each other, and hear the final answer.",
  "main": "src/main/main.js",
  "type": "commonjs",
  "author": "Ron Lukenbaugh",
  "license": "MIT",
  "homepage": "https://github.com/rlukenbaugh/ron-assistant-claude",
  "repository": {
    "type": "git",
    "url": "https://github.com/rlukenbaugh/ron-assistant-claude.git"
  },
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/core/** \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "test:live": "node tests/live/live-agents.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "generate:icons": "node scripts/generate-icons.mjs",
    "dist:win": "npm run generate:icons && electron-builder --config electron-builder.config.js --win nsis portable",
    "publish:win": "npm run generate:icons && electron-builder --config electron-builder.config.js --win nsis portable --publish always",
    "release:notes": "node scripts/render-release-notes.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
